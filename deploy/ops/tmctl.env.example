# Root-owned runtime configuration for /usr/local/sbin/tmctl-root.
# Install as /etc/telegram-manager/tmctl.env with mode 600.
# Routine operator access is the isolated system user telegram-manager.

TM_OPERATOR_USER=telegram-manager
TM_DEPLOY_KEY=/opt/telegram-manager/secrets/github-deploy-key
TM_DEPLOY_LOCK=/run/lock/telegram-manager.deploy.lock
TM_WORKER_STAGE=/opt/telegram-manager/staging/worker
TM_WHATSAPP_STAGE=/opt/telegram-manager/staging/whatsapp
TM_WHATSAPP_IMAGE=telegram-manager-whatsapp:V93
TM_WHATSAPP_ENABLED=false

TM_RELEASE_REPO=/opt/telegram-manager/git-v31
TM_RELEASE_COMPOSE=/opt/telegram-manager/git-v31/deploy/v31/compose.production.yaml
TM_PREVIOUS_COMPOSE=/opt/telegram-manager/releases/V30/deploy/compose.production.yaml

TM_PROJECT_NAME=telegram-manager-v31-production
TM_API_IMAGE=telegram-manager:V31
TM_CALENDAR_IMAGE=telegram-manager-calendar:V31

TM_API_ENV_FILE=/opt/telegram-manager/secrets/api-v20.env
TM_API_DSN_FILE=/opt/telegram-manager/v29-production/credentials/api.env
TM_CALENDAR_ENV_FILE=/opt/telegram-manager/v29-production/credentials/calendar.env

TM_DATABASE_NETWORK=telegram-manager_database
TM_STATE_DIR=/opt/telegram-manager/state

# Exact known temporary containers only. No wildcard deletion.
TM_STALE_CONTAINERS="telegram-manager-v29-migration-test telegram-manager-v25-stage-db-1"
