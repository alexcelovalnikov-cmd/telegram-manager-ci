FROM python:3.12-slim
WORKDIR /app
COPY requirements.calendar.txt ./
RUN pip install --no-cache-dir -r requirements.calendar.txt && pip check && useradd --uid 10001 --create-home tmcalendar
COPY tm_api ./tm_api
COPY tm_calendar ./tm_calendar
COPY tm_reminders ./tm_reminders
COPY deploy/v24/radicale.conf /etc/radicale/config
USER 10001
CMD ["gunicorn","tm_calendar.wsgi:application","--bind","0.0.0.0:5232","--workers","2","--threads","2","--timeout","45","--error-logfile","-","--log-level","warning"]
