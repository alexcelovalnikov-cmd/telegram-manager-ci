# Separate HTTPS virtual host. Replace calendar.example.invalid and certificate paths.
# Put limit_req_zone in the enclosing nginx http block, not inside server.
limit_req_zone $binary_remote_addr zone=tm_calendar_auth:10m rate=5r/s;
server {
    listen 443 ssl;
    server_name calendar.example.invalid;
    ssl_certificate /path/to/fullchain.pem;
    ssl_certificate_key /path/to/privkey.pem;
    client_max_body_size 2m;
    location = /.well-known/caldav { return 301 https://$host/; }
    location / {
        limit_req zone=tm_calendar_auth burst=15 nodelay;
        proxy_pass http://127.0.0.1:5232;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_read_timeout 45s;
        proxy_buffering off;
    }
}
